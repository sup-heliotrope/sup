#!/usr/bin/env ruby

$:.unshift File.join(File.dirname(__FILE__), *%w[.. lib])

require 'optimist'
require 'sup'

opts = Optimist::options do
  version "sup-recover-sources (sup #{Redwood::VERSION})"
  banner <<EOS
Rebuilds a lost sources.yaml file by reading messages from a list of
sources and determining, for each source, the most prevalent
'source_id' field of messages from that source in the index.

The only non-deterministic component to this is that if the same
message appears in multiple sources, those sources may be
mis-diagnosed by this program.

Usage:
  sup-recover-sources [options] <source>*

where <source>* is one or more source URIs.

If the first N messages (--scan-num below) all have the same source_id
in the index, the source will be added to sources.yaml. Otherwise, the
distribution will be printed, and you will have to add it by hand.

Options include:
EOS
  opt :unusual, "Mark sources as 'unusual'. They will not be polled automatically.", :default => false, :short => :none
  opt :archive, "Mark sources as 'archive'. New messages from these sources will not appear in the inbox.", :default => false, :short => :none
  opt :scan_num, "Number of messages to scan per source.", :default => 10, :short => :none
end

Optimist::die "nothing to do: no sources given" if ARGV.empty?

Redwood::start
index = Redwood::Index.init
index.load

begin
  ARGV.each do |uri|
    next if Redwood::SourceManager.source_for uri

    source =
      case uri
      when /^maildir:/
        Redwood::Maildir.new uri, !opts[:unusual], opts[:archive], false, nil, []
      when /^mbox:/
        Redwood::MBox.new uri, !opts[:unusual], opts[:archive], nil, []
      else
        Optimist::die "Sources must be specified with a maildir:// or mbox:// URI"
      end

    source_ids = Hash.new 0
    count = 0
    source.each_message do |source_info|
      location = Redwood::Location.new(source, source_info)
      debug "checking message from #{source_info}"
      m = Redwood::Message.new :locations => [location]
      m.load_from_source!
      indexed_source_ids = index.locations_for_id(m.id).select { |s, i| i == source_info }.map { |s, i| s }
      if indexed_source_ids.empty?
        debug "not found in index"
        next
      end
      debug "found with source ids #{indexed_source_ids.inspect}"
      indexed_source_ids.each { |id| source_ids[id] += 1 }
      count += 1
      break if count == opts[:scan_num]
    end

    if source_ids.size == 1
      id = source_ids.keys.first.to_i
      puts "assigned #{source} to #{source_ids.keys.first}"
      source.id = id
      Redwood::SourceManager.add_source source
    else
      puts ">> unable to determine #{source}: #{source_ids.inspect}"
    end
  end
ensure
  index.save
  Redwood::finish
end
